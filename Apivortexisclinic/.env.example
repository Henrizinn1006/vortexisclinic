# =============================================================
# Vortexis Clinic — API
# Copie para .env e preencha com os SEUS valores.
#
# Este arquivo é só o mapa das variáveis: todo valor aqui é
# fictício ou inofensivo. O .env de verdade está no .gitignore e
# nunca deve ser commitado, enviado por chat ou colado em print.
# =============================================================

# ---------------- Ambiente ----------------
VC_ENV=development              # development | test | production
VC_DEBUG=false
VC_LOG_LEVEL=INFO

# ---------------- Banco (MySQL) ----------------
VC_DB_HOST=127.0.0.1
VC_DB_PORT=3306
VC_DB_NAME=vortexis_clinic
VC_DB_USER=troque_pelo_seu_usuario
VC_DB_PASSWORD=troque_pela_sua_senha
# Caminho do certificado quando o MySQL exigir TLS. Deixe vazio se não usa.
# O comentário fica NESTA linha de propósito: comentário na mesma linha de um
# valor vazio vira o próprio valor, e a conexão morre sem dizer por quê.
VC_DB_SSL_CA=
VC_DB_ECHO=false                # true imprime todo SQL: só para depurar, nunca em produção
VC_DB_POOL_SIZE=5
VC_DB_POOL_RECYCLE=1800

# ---------------- Sessão e cookies ----------------
VC_SESSION_COOKIE_NAME=vc_session
VC_CSRF_COOKIE_NAME=vc_csrf
VC_SESSION_IDLE_MINUTES=720     # 12h sem uso encerra a sessão
VC_SESSION_ABSOLUTE_HOURS=168   # 7 dias no máximo, usando ou não
VC_COOKIE_SECURE=false          # OBRIGATÓRIO true em produção (HTTPS)
VC_COOKIE_SAMESITE=lax          # lax | strict | none (none exige Secure)
VC_COOKIE_DOMAIN=
VC_COOKIE_PATH=/

# ---------------- CORS ----------------
# Origens do painel, separadas por vírgula. Vazio = só mesma origem.
VC_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---------------- Rate limit ----------------
VC_RATE_LIMIT_LOGIN=8
VC_RATE_LIMIT_LOGIN_WINDOW=300
VC_RATE_LIMIT_REGISTER=5
VC_RATE_LIMIT_REGISTER_WINDOW=3600

# ---------------- E-mail ----------------
# queue   = só enfileira (padrão; nada some, tudo fica visível na fila)
# console = imprime no log — dá para testar o fluxo sem mandar e-mail
# smtp    = entrega de verdade
VC_MAIL_BACKEND=queue
VC_MAIL_FROM=Vortexis Clinic <nao-responda@seudominio.com.br>
VC_MAIL_REPLY_TO=
VC_SMTP_HOST=
VC_SMTP_PORT=587
VC_SMTP_USER=
VC_SMTP_PASSWORD=
VC_SMTP_TLS=true
VC_MAIL_MAX_ATTEMPTS=5
VC_REMINDER_HOURS=24
VC_EMAIL_VERIFY_TTL_HOURS=48

# Endereço do painel — usado para montar os links que vão nos e-mails.
# Sem barra no fim. Vazio usa a primeira origem do CORS.
VC_PANEL_URL=

# ---------------- Documentos ----------------
# Onde os arquivos cifrados ficam. Relativo é a partir de onde a API roda.
VC_FILES_DIR=arquivos
VC_MAX_UPLOAD_MB=8

# ---------------- Senha ----------------
VC_ARGON2_TIME_COST=3
VC_ARGON2_MEMORY_KB=65536
VC_ARGON2_PARALLELISM=2
VC_PASSWORD_MIN_LENGTH=10
VC_PASSWORD_RESET_TTL_MINUTES=30

# ---------------- Cifra do conteúdo clínico ----------------
# Chaves de 32 bytes em base64, uma por versão: "1:chave,2:chave".
# Gerar uma nova:  python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# NUNCA versionar o valor real. Rotacionar = acrescentar a versão
# seguinte e apontar VC_CLINICAL_KEY_VERSION para ela; as anteriores
# continuam na lista para que o acervo antigo siga legível.
VC_CLINICAL_KEYS=1:COLOQUE_AQUI_UMA_CHAVE_BASE64_DE_32_BYTES
VC_CLINICAL_KEY_VERSION=1
